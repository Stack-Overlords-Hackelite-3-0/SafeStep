# Copy this file to .env and fill in your own values.

# PostgreSQL connection string
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# Port 5433 matches the docker-compose.yml mapping (chosen to avoid clashing
# with a locally-installed PostgreSQL service on the default port 5432).
# If you're using your own local PostgreSQL install instead of Docker,
# change this back to port 5432 (or whatever you configured).
DATABASE_URL=postgresql+psycopg2://safestep:safestep@localhost:5433/safestep

# Auth
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound email (optional). Used to notify a user by email when someone adds
# them as a trusted contact. Leave SMTP_HOST blank to skip sending — the
# invitation still shows up in-app either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Base URL of the deployed frontend, used to build the link in invite emails.
FRONTEND_URL=http://localhost:5173

# Chatbot LLM (optional). Leave LLM_PROVIDER=none to use the built-in
# rule-based responder - no API key required, works fully offline.
# Set LLM_PROVIDER=ollama to use a local model (e.g. Llama 3 8B) via
# https://ollama.com - no API key needed, just make sure `ollama serve`
# is running and you've pulled the model (`ollama pull llama3:8b`).
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

ENV=development
